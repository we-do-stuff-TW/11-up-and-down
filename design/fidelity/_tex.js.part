function mulberry32(a){
  return function(){
    a |= 0; a = a + 0x6D2B79F5 | 0;
    let t = Math.imul(a ^ a >>> 15, 1 | a);
    t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t;
    return ((t ^ t >>> 14) >>> 0) / 4294967296;
  };
}
/* 週期性的值雜訊：格點取隨機值、平滑插值、幾個八度疊起來。邊界會接上，貼圖重複時沒有縫 */
function noiseField(size, cells, octaves, seed){
  const rnd = mulberry32(seed);
  const acc = new Float32Array(size * size);
  const smooth = t => t * t * (3 - 2 * t);
  let amp = 1, tot = 0, c = cells;
  for(let o = 0; o < octaves; o++){
    const lat = new Float32Array(c * c);
    for(let i = 0; i < c * c; i++) lat[i] = rnd();
    for(let y = 0; y < size; y++){
      const fy = y / size * c, y0 = Math.floor(fy), ty = smooth(fy - y0), y1 = (y0 + 1) % c;
      for(let x = 0; x < size; x++){
        const fx = x / size * c, x0 = Math.floor(fx), tx = smooth(fx - x0), x1 = (x0 + 1) % c;
        const a = lat[y0 * c + x0], b = lat[y0 * c + x1], d = lat[y1 * c + x0], e = lat[y1 * c + x1];
        const top = a + (b - a) * tx, bot = d + (e - d) * tx;
        acc[y * size + x] += (top + (bot - top) * ty) * amp;
      }
    }
    tot += amp; amp *= .5; c *= 2;
  }
  for(let i = 0; i < acc.length; i++) acc[i] /= tot;
  return acc;
}
function sampler(f, size){
  return function(u, v){
    const x = ((u % 1) + 1) % 1 * size, y = ((v % 1) + 1) % 1 * size;
    const x0 = Math.floor(x) % size, y0 = Math.floor(y) % size, tx = x - Math.floor(x), ty = y - Math.floor(y);
    const x1 = (x0 + 1) % size, y1 = (y0 + 1) % size;
    const a = f[y0 * size + x0], b = f[y0 * size + x1], c = f[y1 * size + x0], d = f[y1 * size + x1];
    const top = a + (b - a) * tx, bot = c + (d - c) * tx;
    return top + (bot - top) * ty;
  };
}
function fieldTex(f, size, o){
  const cv = document.createElement("canvas"); cv.width = cv.height = size;
  const g = cv.getContext("2d"), im = g.createImageData(size, size), d = im.data;
  for(let i = 0; i < f.length; i++){ const v = f[i] * 255; d[i*4] = d[i*4+1] = d[i*4+2] = v; d[i*4+3] = 255; }
  g.putImageData(im, 0, 0);
  const t = new THREE.CanvasTexture(cv);
  t.wrapS = t.wrapT = THREE.RepeatWrapping;
  if(o && o.repeat) t.repeat.set(o.repeat, o.repeat);
  if(o && o.srgb) t.colorSpace = THREE.SRGBColorSpace;
  return t;
}
/* 桌布：燈罩下的光暈畫在布上（中央亮、往外慢慢沉、最外一圈是木沿投下的暗），
   疊上絨面的斑駁與細纖維。燈不必開到會把牌面燒白 */
function feltTex(){
  const N = 1024, cv = document.createElement("canvas"); cv.width = cv.height = N;
  const g = cv.getContext("2d"), im = g.createImageData(N, N), d = im.data;
  const mottle = sampler(noiseField(256, 6, 4, 11), 256);
  const fine = mulberry32(5);
  for(let y = 0; y < N; y++) for(let x = 0; x < N; x++){
    const dx = x / N - .5, dy = y / N - .5, r = Math.min(1, Math.sqrt(dx*dx + dy*dy) * 2);
    let v = .90 - .22 * Math.pow(r, 2.2);
    if(r > .965) v *= 1 - (r - .965) / .035 * .42;
    v *= 1 + (mottle(x / N * 3, y / N * 3) - .5) * .16 + (fine() - .5) * .05;
    const c = Math.max(0, Math.min(255, v * 255));
    const i = (y * N + x) * 4; d[i] = d[i+1] = d[i+2] = c; d[i+3] = 255;
  }
  g.putImageData(im, 0, 0);
  const t = new THREE.CanvasTexture(cv);
  t.colorSpace = THREE.SRGBColorSpace;
  return t;
}
/* 胡桃木：年輪沿著桌沿繞一圈（像彎板收邊），緩慢起伏加細孔。u 是繞圈方向，v 沿著剖面 */
function woodTex(){
  const W = 2048, H = 256, cv = document.createElement("canvas"); cv.width = W; cv.height = H;
  const g = cv.getContext("2d"), im = g.createImageData(W, H), d = im.data;
  const low = sampler(noiseField(256, 4, 3, 21), 256), hi = sampler(noiseField(256, 32, 3, 22), 256);
  const A = [0x3a, 0x24, 0x16], B = [0x6c, 0x48, 0x2f];
  for(let y = 0; y < H; y++) for(let x = 0; x < W; x++){
    const u = x / W, v = y / H;
    const wob = (low(u * 2, v * .5) - .5) * 2.2;
    const ring = .5 + .5 * Math.sin((v * 7 + wob + (hi(u * 3, v) - .5) * .4) * Math.PI * 2);
    const k = Math.pow(ring, 1.4) * .66 + hi(u * 12, v * 3) * .34;
    const i = (y * W + x) * 4;
    for(let ch = 0; ch < 3; ch++) d[i+ch] = A[ch] + (B[ch] - A[ch]) * k;
    d[i+3] = 255;
  }
  g.putImageData(im, 0, 0);
  const t = new THREE.CanvasTexture(cv);
  t.colorSpace = THREE.SRGBColorSpace;
  t.wrapS = THREE.RepeatWrapping; t.repeat.set(3, 1);
  return t;
}
/* 接觸陰影：一片比牌略大、中央深邊緣散開的黑，貼在每張牌底下。
   由外往內疊十幾層圓角矩形把邊緣糊開——不用 canvas filter，舊 Safari 沒有 */
function aoTex(){
  const W = 128, H = 176, cv = document.createElement("canvas"); cv.width = W; cv.height = H;
  const g = cv.getContext("2d");
  const steps = 14;
  for(let i = 0; i < steps; i++){
    const k = i / (steps - 1), m = 4 + (1 - k) * 16;
    g.fillStyle = "rgba(0,0,0," + (.05 + k * .05).toFixed(3) + ")";
    g.beginPath(); g.roundRect(m, m, W - 2*m, H - 2*m, 9); g.fill();
  }
  const t = new THREE.CanvasTexture(cv);
  return t;
}
/* 環境光不是載一張 HDR，而是拼一間房：天花板一片暖光、兩側是壁爐那頭的橘、深胡桃木的牆，
   經 PMREM 之後成為牌與桌面的漫射環境。牌很粗糙，這道光只給均勻的底亮，不會出現亮斑。 */
function makeEnv(r){
  const pm = new THREE.PMREMGenerator(r);
  const room = new THREE.Scene();
  const em = (c, k) => new THREE.MeshBasicMaterial({color:new THREE.Color(c).multiplyScalar(k)});
  const walls = new THREE.Mesh(new THREE.BoxGeometry(24, 12, 24), em(0x3a2616, .5));
  walls.material.side = THREE.BackSide;
  room.add(walls);
  const ceil = new THREE.Mesh(new THREE.PlaneGeometry(7, 7), em(0xfff2e2, 4.5));
  ceil.position.set(0, 5.9, 1.2); ceil.rotation.x = Math.PI / 2;
  room.add(ceil);
  for(const sx of [-1, 1]){
    const p = new THREE.Mesh(new THREE.PlaneGeometry(5, 3), em(0xff9a50, 1.2));
    p.position.set(sx * 10, 2.4, 0); p.rotation.y = -sx * Math.PI / 2;
    room.add(p);
  }
  const front = new THREE.Mesh(new THREE.PlaneGeometry(9, 2.4), em(0x5a3a22, .7));
  front.position.set(0, 2.0, 10.5); front.rotation.y = Math.PI;
  room.add(front);
  const env = pm.fromScene(room, .06).texture;
  pm.dispose();
  return env;
}

/* 贏牌的金線：以牌的圓角矩形為零點的距離場——貼著牌邊外側一條細線，外面 .24 個牌寬內一圈很窄的暈。
   加色疊在桌布上、不染色；中間被牌自己遮住。線的位置與粗細是 Francis 在示範頁上看過的那組。 */
const RING_REACH = .26;
function ringTex(){
  const pw = CARD_W + 2*RING_REACH, ph = CARD_H + 2*RING_REACH;
  const W = 384, H = Math.round(W * ph / pw), cv = document.createElement("canvas"); cv.width = W; cv.height = H;
  const g = cv.getContext("2d"), im = g.createImageData(W, H), d = im.data;
  const hx = CARD_W / 2, hy = CARD_H / 2, r = .058;
  for(let y = 0; y < H; y++) for(let x = 0; x < W; x++){
    const px = (x / W - .5) * pw, py = (y / H - .5) * ph;
    const qx = Math.abs(px) - (hx - r), qy = Math.abs(py) - (hy - r);
    const dist = Math.hypot(Math.max(qx, 0), Math.max(qy, 0)) + Math.min(Math.max(qx, qy), 0) - r;
    const line = Math.exp(-Math.pow((dist - .009) / .0065, 2));
    const halo = dist > 0 ? Math.pow(Math.max(0, 1 - dist / .24), 2.2) * .42 : 0;
    const c = Math.round(Math.min(1, line + halo) * 255), i = (y * W + x) * 4;
    d[i] = d[i+1] = d[i+2] = c; d[i+3] = 255;
  }
  g.putImageData(im, 0, 0);
  const t = new THREE.CanvasTexture(cv); t.anisotropy = 4;
  return t;
}

const TABLE_H = 2.3;      /* 桌面到地板的高度（牌寬單位） */
