/* TITLE: B 滿版牌桌 · 開房 */
/* ── B 案：桌子就是整頁，規則是浮在桌面上的一塊玻璃。設定＝置中的規則卡。 ── */
.pg{position:fixed;inset:0;overflow:hidden}

/* ── 桌子：填滿畫面，左右被裁掉——你是坐在桌邊往下看 ─────── */
.tbl{
  position:absolute;left:50%;top:50%;translate:-50% -50%;
  width:1760px;height:720px;border-radius:50%;padding:30px;
  background:
    linear-gradient(152deg in oklab,oklch(.292 .021 58),oklch(.172 .015 58) 52%,oklch(.243 .019 58));
  box-shadow:
    inset 0 2px 0 oklch(1 0 0/.14),
    inset 0 -3px 5px rgba(0,0,0,.5),
    0 40px 90px rgba(0,0,0,.5);
  transition:filter .4s var(--e-out),transform .5s var(--e-out)}
/* 皮革護手上的一圈車線 */
.tbl::before{content:"";position:absolute;inset:13px;border-radius:50%;
  border:1px dashed oklch(.78 .06 84/.22)}
.felt{position:absolute;inset:30px;border-radius:50%;overflow:hidden;
  background:radial-gradient(100% 108% at 50% 20% in oklab,
    oklch(.368 .0135 250),oklch(.298 .0115 250) 46%,oklch(.214 .0095 250));
  box-shadow:inset 0 0 0 1.5px oklch(.70 .075 84/.22),inset 0 0 70px rgba(0,0,0,.45)}

/* ── 中央：房號就是四張發好的牌 ────────────────────────── */
.mid{position:absolute;left:50%;top:50%;translate:-50% -50%;display:flex;flex-direction:column;
  align-items:center;gap:16px}
.mid .cap{color:oklch(.56 .012 250)}
.cards{display:flex;gap:12px}
.cardz{width:78px;height:108px;border-radius:9px;display:grid;place-items:center;position:relative;
  font-family:"Bodoni Moda",Georgia,serif;font-size:44px;font-weight:600;color:var(--stock-ink);
  background:linear-gradient(158deg in oklab,#FDFAF3,var(--stock) 46%,var(--stock-2));
  box-shadow:inset 0 0 0 1px rgba(26,23,20,.16),inset 0 1px 0 rgba(255,255,255,.9),
    0 1px 2px rgba(0,0,0,.34),0 10px 22px rgba(0,0,0,.34);
  rotate:var(--r,0deg)}
.cardz::before{content:"";position:absolute;inset:5px;border-radius:5px;border:.5px solid var(--foil-2);opacity:.44}
.copy{display:flex;align-items:center;gap:8px;font-size:11.5px;color:var(--ink-3);
  padding:7px 14px;border-radius:99px;transition:background .18s,color .18s}
.copy:hover{background:oklch(1 0 0/.05);color:var(--ink-2)}
.copy i{width:3px;height:3px;border-radius:99px;background:var(--foil-2);display:block}

/* ── 座位：坐了人是一塊放在護手上的牌子，沒人是護手上挖的一個凹 ── */
.seat{position:absolute;left:50%;top:50%;
  translate:calc(-50% + var(--x)) calc(-50% + var(--y));
  display:flex;align-items:center;gap:11px;padding:9px 16px 9px 9px;border-radius:99px;
  background:oklch(.98 .012 92/.075);
  box-shadow:inset 0 1px 0 var(--glass-lip),0 0 0 1px var(--hair),var(--sh-glass);
  backdrop-filter:blur(7px);-webkit-backdrop-filter:blur(7px);white-space:nowrap}
.seat .who{display:flex;flex-direction:column;gap:3px;line-height:1}
.seat .who b{font-size:14px;font-weight:600}
.seat .who .sub{font-size:10px;letter-spacing:.12em;color:var(--ink-3)}
.seat.me{box-shadow:inset 0 1px 0 var(--glass-lip),0 0 0 1px oklch(.845 .128 84/.34),var(--sh-glass)}
.seat.me .who b{color:var(--brass)}
.dot{width:5px;height:5px;border-radius:99px;background:var(--good);display:inline-block;margin-right:5px;
  vertical-align:1px;box-shadow:0 0 0 3px oklch(.800 .125 156/.14)}
.slot{position:absolute;left:50%;top:50%;
  translate:calc(-50% + var(--x)) calc(-50% + var(--y));
  display:grid;place-items:center;width:150px;height:46px;border-radius:99px;
  font-size:12px;letter-spacing:.1em;color:oklch(.60 .012 250);
  background:oklch(0 0 0/.16);
  box-shadow:inset 0 1px 2px rgba(0,0,0,.45),inset 0 -1px 0 oklch(1 0 0/.07);
  transition:color .2s,background .2s}
.slot:hover{color:var(--ink-2);background:oklch(0 0 0/.1)}
.slot .ai{position:absolute;opacity:0;transition:opacity .2s;font-size:12px;letter-spacing:.02em}
.slot:hover .txt{opacity:0}.slot:hover .ai{opacity:1}
.slot .txt{transition:opacity .2s}

/* ── 浮在桌面上的東西 ──────────────────────────────────── */
.mk{position:absolute;top:26px;left:30px;z-index:4}
.leave{position:absolute;top:24px;left:190px;z-index:4}
.me-chip{position:absolute;top:24px;right:26px;z-index:4;display:flex;align-items:center;gap:9px}
.me-chip .nm{font-size:13px;color:var(--ink-2)}
.me-chip .av{width:26px;height:26px}

/* 規則：整頁唯一浮起來的板子 */
.card{position:absolute;top:50%;right:26px;translate:0 -50%;z-index:5;width:290px;padding:18px 20px 16px;
  border-radius:18px;background:oklch(.24 .009 250/.72);
  box-shadow:inset 0 1px 0 var(--glass-lip),0 0 0 1px var(--hair),0 18px 50px rgba(0,0,0,.46);
  backdrop-filter:blur(16px) saturate(1.1);-webkit-backdrop-filter:blur(16px)}
.cardhd{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px}
.cardhd h2{font-size:13px;font-weight:600;letter-spacing:.04em}
.gear{display:flex;align-items:center;gap:6px;font-size:11.5px;color:var(--ink-3);
  padding:6px 10px;border-radius:99px;transition:.18s}
.gear:hover{color:var(--ink);background:oklch(1 0 0/.06)}
.gear svg{width:12px;height:12px;fill:none;stroke:currentColor;stroke-width:1.4}
.r{display:flex;align-items:baseline;justify-content:space-between;gap:12px;padding:7px 0;
  border-bottom:1px solid var(--hair-2)}
.r:last-of-type{border-bottom:0}
.r .k{font-size:11.5px;color:var(--ink-3)}
.r .v{font-size:12.5px;color:var(--ink)}
.sum{display:flex;gap:18px;margin-top:12px;padding-top:12px;border-top:1px solid var(--hair)}
.sum .k{font-size:9px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-3);margin-bottom:3px}
.sum .v{font-family:"IBM Plex Mono",monospace;font-size:17px;font-variant-numeric:tabular-nums;line-height:1}

.bottom{position:absolute;right:26px;bottom:26px;z-index:4;display:flex;flex-direction:column;
  align-items:flex-end;gap:9px;width:290px}
.bottom .go{width:100%;padding:14px 40px}
.bottom p{margin:0;font-size:11px;color:var(--ink-3);letter-spacing:.03em;text-align:right;line-height:1.55}

/* ── 設定：桌子退到後面，規則卡放到正中間 ─────────────── */
.sheet{position:fixed;inset:0;z-index:9;display:none;place-items:center;padding:30px;
  background:oklch(.16 .006 250/.38);backdrop-filter:blur(2px)}
body.set .sheet{display:grid}
body.set .tbl{filter:saturate(.7) brightness(.86) blur(1.5px);transform:scale(.985)}
body.set .card,body.set .bottom,body.set .seat,body.set .slot,body.set .mid,body.set .me-chip{opacity:0;pointer-events:none}
.sheetbox{width:min(900px,100%);max-height:100%;overflow:auto;padding:26px 30px 22px;border-radius:22px;
  background:oklch(.235 .009 250/.88);
  box-shadow:inset 0 1px 0 var(--glass-lip),0 0 0 1px var(--hair),0 30px 80px rgba(0,0,0,.55);
  backdrop-filter:blur(20px)}
.sheethd{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:18px}
.sheethd h2{font-family:"Bodoni Moda",Georgia,serif;font-size:26px;font-weight:600;letter-spacing:-.005em}
.sheethd p{margin:4px 0 0;font-size:11.5px;color:var(--ink-3)}
.done{padding:9px 20px;border-radius:99px;font-size:12.5px;color:var(--ink);
  background:var(--glass);box-shadow:inset 0 1px 0 var(--glass-lip),0 0 0 1px var(--hair)}
.done:hover{background:oklch(.98 .012 92/.13)}
.cols{display:grid;grid-template-columns:1fr 1fr;gap:0 38px}
.sect{grid-column:span 1}
.sect>.cap{display:block;padding-bottom:8px;border-bottom:1px solid var(--hair);margin-bottom:4px}
.f{padding:11px 0;border-bottom:1px solid var(--hair-2)}
.f:last-child{border-bottom:0}
.f>label{display:block;font-size:12.5px;color:var(--ink-2);margin-bottom:8px}
.opts{display:flex;gap:5px;flex-wrap:wrap}
.opt{padding:6px 13px;border-radius:99px;border:1px solid var(--hair);font-size:12.5px;color:var(--ink-3);
  transition:border-color .16s,color .16s,background-color .16s}
.opt:hover{color:var(--ink-2);border-color:var(--glass-edge)}
.opt[aria-pressed=true]{border-color:var(--brass);color:var(--brass);background:var(--brass-soft)}
.note{margin:8px 0 0;font-size:11px;line-height:1.6;color:var(--ink-3)}
.ex{margin-top:14px}
.ex>.cap{display:block;padding-bottom:8px;border-bottom:1px solid var(--hair);margin-bottom:6px}
.ex table{width:100%;border-collapse:collapse;font-size:12.5px}
.ex td{padding:8px 0;border-bottom:1px solid var(--hair-2);color:var(--ink-3)}
.ex td.p,.ex td.m{font-family:"IBM Plex Mono",monospace;font-variant-numeric:tabular-nums;
  text-align:right;padding-right:22px;color:var(--ink)}
.ex td.p{color:var(--good)}
.ex td.m{color:var(--bad)}
.sheetft{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;
  margin-top:18px;padding-top:16px;border-top:1px solid var(--hair)}
.sheetft .sum{border:0;margin:0;padding:0;gap:30px}
.sheetft .sum .v{font-size:24px}
.sheetft .tail{font-size:11.5px;color:var(--ink-3);max-width:34ch;text-align:right}
/*==HTML==*/
<div class="pg">
  <div class="tbl">
    <div class="felt">
      <div class="grain"></div>
    </div>
  </div>

  <div class="mid">
    <span class="cap">房號</span>
    <div class="cards">
      <span class="cardz" style="--r:-2.5deg">7</span>
      <span class="cardz" style="--r:1.5deg">K</span>
      <span class="cardz" style="--r:-1deg">2</span>
      <span class="cardz" style="--r:2.5deg">M</span>
    </div>
    <button class="copy"><i></i>按一下複製，貼給朋友</button>
  </div>

  <div class="seat me" style="--x:0px;--y:314px">
    <img class="av" src="__AV__" alt="">
    <div class="who"><b>Francis</b><span class="sub">房主 · 你</span></div>
  </div>
  <div class="seat" style="--x:-478px;--y:257px">
    <div class="mono-av">哲</div>
    <div class="who"><b>阿哲</b><span class="sub"><span class="dot"></span>在線上</span></div>
  </div>
  <button class="slot" style="--x:-478px;--y:-257px"><span class="txt">空位</span><span class="ai">放一個 AI 進來</span></button>
  <div class="seat" style="--x:0px;--y:-314px">
    <div class="mono-av">圓</div>
    <div class="who"><b>小圓</b><span class="sub"><span class="dot"></span>在線上</span></div>
  </div>
  <button class="slot" style="--x:478px;--y:-257px"><span class="txt">空位</span><span class="ai">放一個 AI 進來</span></button>
  <button class="slot" style="--x:478px;--y:257px"><span class="txt">空位</span><span class="ai">放一個 AI 進來</span></button>

  <div class="mk"><b>11</b><u>UP &amp; DOWN</u></div>
  <button class="ghost leave">離開房間</button>
  <div class="me-chip"><span class="nm">Francis</span><img class="av" src="__AV__" alt=""></div>

  <aside class="card">
    <div class="cardhd">
      <h2>這一桌的規則</h2>
      <button class="gear" id="toSet">
        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3.2"/><path d="M12 2.6v3M12 18.4v3M21.4 12h-3M5.6 12h-3M18.6 5.4l-2.1 2.1M7.5 16.5l-2.1 2.1M18.6 18.6l-2.1-2.1M7.5 7.5L5.4 5.4"/></svg>
        設定
      </button>
    </div>
    <div class="r"><span class="k">叫墩</span><span class="v">依序公開叫</span></div>
    <div class="r"><span class="k">末位限制</span><span class="v">the hook</span></div>
    <div class="r"><span class="k">牌組</span><span class="v">雙副 · 7 以上</span></div>
    <div class="r"><span class="k">鬼牌</span><span class="v">不放</span></div>
    <div class="r"><span class="k">叫中</span><span class="v">10＋叫</span></div>
    <div class="r"><span class="k">叫 0 中了</span><span class="v">5 分</span></div>
    <div class="r"><span class="k">沒叫中</span><span class="v">扣差額</span></div>
    <div class="sum">
      <div><div class="k">牌數</div><div class="v">64</div></div>
      <div><div class="k">最多每人</div><div class="v">11</div></div>
      <div><div class="k">總局數</div><div class="v">21</div></div>
    </div>
  </aside>

  <div class="bottom">
    <button class="go">開始</button>
    <p>三個人就位，兩人以上隨時可以開<br>開打之後這桌就鎖起來，中途進不來</p>
  </div>

  <!-- 設定 -->
  <div class="sheet">
    <div class="sheetbox">
      <div class="sheethd">
        <div><h2>這一桌的規則</h2><p>你是房主，改了桌上每個人都會即時看到。</p></div>
        <button class="done" id="toView">完成</button>
      </div>
      <div class="cols">
        <section class="sect">
          <span class="cap">叫墩</span>
          <div class="f"><label>方式</label>
            <div class="opts"><button class="opt" aria-pressed="true">依序公開叫</button><button class="opt">同時叫墩</button></div>
            <p class="note">從起始玩家開始一位一位叫，後面的人看得到前面叫了多少。</p></div>
          <div class="f"><label>末位限制</label>
            <div class="opts"><button class="opt" aria-pressed="true">the hook</button><button class="opt">不限制</button></div>
            <p class="note">最後一位不得讓總叫墩數剛好等於總墩數：每一局一定有人要叫不中。</p></div>
          <span class="cap" style="display:block;margin-top:16px;padding-bottom:8px;border-bottom:1px solid var(--hair)">牌</span>
          <div class="f"><label>牌組</label>
            <div class="opts"><button class="opt">單副</button><button class="opt" aria-pressed="true">雙副</button></div></div>
          <div class="f"><label>最小點數</label>
            <div class="opts"><button class="opt">9</button><button class="opt" aria-pressed="true">7</button><button class="opt">6</button><button class="opt">5</button><button class="opt">4</button><button class="opt">3</button><button class="opt">2</button></div></div>
          <div class="f"><label>鬼牌</label>
            <div class="opts"><button class="opt" aria-pressed="true">不放</button><button class="opt">放兩張</button></div></div>
        </section>
        <section class="sect">
          <span class="cap">計分</span>
          <div class="f"><label>叫中得分</label>
            <div class="opts"><button class="opt" aria-pressed="true">10＋叫</button><button class="opt">10×叫</button><button class="opt">10＋叫²</button></div>
            <p class="note">叫 3 中了 13 分。叫大墩沒有溢價，所以永遠叫最可能中的那個數。</p></div>
          <div class="f"><label>叫 0 中了</label>
            <div class="opts"><button class="opt" aria-pressed="true">5 分</button><button class="opt">5＋該局張數</button></div>
            <p class="note">不管幾張牌都是 5 分——叫 0 是不得已，不是策略。</p></div>
          <div class="f"><label>沒叫中</label>
            <div class="opts"><button class="opt" aria-pressed="true">扣差額</button><button class="opt">扣 10×差</button><button class="opt">扣差額²</button></div>
            <p class="note">叫 3 拿 4 扣 1 分。罰得很輕，所以去破壞別人很便宜。</p></div>
          <div class="ex">
            <span class="cap">用這組規則實際算</span>
            <table>
              <tr><td>叫 3，拿 3</td><td class="p">＋13</td><td>叫 0，拿 0</td><td class="p">＋5</td></tr>
              <tr><td>叫 3，拿 4</td><td class="m">−1</td><td>叫 3，拿 0</td><td class="m">−3</td></tr>
            </table>
          </div>
        </section>
      </div>
      <div class="sheetft">
        <div class="sum">
          <div><div class="k">牌數</div><div class="v">64</div></div>
          <div><div class="k">最多每人</div><div class="v">11</div></div>
          <div><div class="k">總局數</div><div class="v">21</div></div>
        </div>
        <p class="tail">六十四張牌、四個人，階梯走得到 11 張、共 21 局。</p>
      </div>
    </div>
  </div>
</div>

<div class="dev">
  <button data-v="room" aria-pressed="true">開房</button>
  <button data-v="set">設定</button>
</div>
<script>
const setv = v => {
  document.body.classList.toggle("set", v === "set");
  document.querySelectorAll(".dev button").forEach(b => b.setAttribute("aria-pressed", b.dataset.v === v));
};
document.querySelector(".dev").onclick = e => { const b = e.target.closest("button"); if(b) setv(b.dataset.v); };
document.getElementById("toSet").onclick = () => setv("set");
document.getElementById("toView").onclick = () => setv("room");
document.addEventListener("click", e => {
  const o = e.target.closest(".opt");
  if(!o) return;
  o.parentElement.querySelectorAll(".opt").forEach(b => b.setAttribute("aria-pressed", "false"));
  o.setAttribute("aria-pressed", "true");
});
if(location.search.includes("set")) setv("set");
</script>
