/* TITLE: A 圍桌 · 開房 */
/* ── A 案：桌子在左，規則在右欄。設定＝右欄自己長大，桌子還在。 ── */
.pg{flex:1;display:flex;flex-direction:column;min-height:100dvh}
.top{display:flex;align-items:center;justify-content:space-between;
  padding:20px clamp(20px,2.4vw,34px);gap:20px}
.top .you{display:flex;align-items:center;gap:10px;margin-left:auto}
.top .you .nm{font-size:13px;color:var(--ink-2)}
.top .you .av,.top .you .mono-av{width:26px;height:26px;font-size:11px}

.room{flex:1;display:flex;min-height:0}

/* ── 牌桌 ───────────────────────────────────────────────── */
.floor{flex:1;position:relative;display:grid;place-items:center;min-width:0;
  transition:transform .42s var(--e-out),filter .42s var(--e-out)}
.stage{position:relative;width:100%;height:100%;display:grid;place-items:center}
.tbl{
  --rx:344px;--ry:218px;
  width:calc(var(--rx)*2);height:calc(var(--ry)*2);border-radius:50%;position:relative;
  padding:17px;
  background:linear-gradient(158deg in oklab,oklch(.315 .026 62),oklch(.185 .017 62) 54%,oklch(.265 .023 62));
  box-shadow:
    inset 0 1px 0 oklch(1 0 0/.16),
    inset 0 -2px 3px rgba(0,0,0,.5),
    0 2px 4px rgba(0,0,0,.4),
    0 34px 70px rgba(0,0,0,.46),
    0 90px 120px -40px rgba(0,0,0,.55);
}
.felt{
  position:absolute;inset:17px;border-radius:50%;overflow:hidden;
  background:radial-gradient(112% 116% at 50% 22% in oklab,
    oklch(.372 .0135 250),oklch(.300 .0115 250) 48%,oklch(.223 .0095 250));
  box-shadow:
    inset 0 0 0 1px oklch(.70 .075 84/.26),
    inset 0 0 46px rgba(0,0,0,.42),
    inset 0 3px 10px rgba(0,0,0,.34);
}
/* 桌面中央刻著房號——不是貼上去的標籤，是壓進絨布的字 */
.plate{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:9px}
.plate .code{font-size:76px;font-weight:600;letter-spacing:.16em;text-indent:.16em;line-height:1;
  color:oklch(.246 .010 250);
  text-shadow:0 1.5px 0 oklch(.55 .016 250/.80),0 -1px 1px rgba(0,0,0,.6)}
.plate .cap{color:oklch(.52 .012 250)}
.plate .hint{font-size:11.5px;color:var(--ink-3);opacity:.72;display:flex;align-items:center;gap:7px}
.plate .hint i{width:3px;height:3px;border-radius:99px;background:var(--foil-2);display:block;opacity:.8}
.plate button{border-radius:10px;padding:6px 12px;transition:background .18s}
.plate button:hover{background:oklch(1 0 0/.05)}
.plate button:hover .hint{opacity:1;color:var(--ink-2)}
/* 一疊還沒發的牌，擺在房主手邊 */
.deck{position:absolute;right:11%;top:63%;translate:0 -50%;width:54px;height:76px;rotate:-7deg;
  filter:drop-shadow(0 2px 3px rgba(0,0,0,.45)) drop-shadow(0 10px 18px rgba(0,0,0,.4))}
.deck::after{content:""}

/* ── 座位：入座的人不加框，空位才是一個框 ────────────────── */
.seat{position:absolute;left:50%;top:50%;
  translate:calc(-50% + var(--x)) calc(-50% + var(--y));
  display:flex;align-items:center;gap:11px;white-space:nowrap}
.seat.l{flex-direction:row-reverse}
.seat.l .who{text-align:right}
.who{display:flex;flex-direction:column;gap:3px;line-height:1}
.who b{font-size:14px;font-weight:600;letter-spacing:.01em}
.who .sub{font-size:10.5px;letter-spacing:.1em;color:var(--ink-3)}
.who .sub em{font-style:normal;color:var(--foil-2)}
.seat.me .who b{color:var(--brass)}
.dot{width:5px;height:5px;border-radius:99px;background:var(--good);display:inline-block;
  margin-right:5px;vertical-align:1px;box-shadow:0 0 0 3px oklch(.800 .125 156/.14)}
.seat .av,.seat .mono-av{width:42px;height:42px}

.slot{position:absolute;left:50%;top:50%;
  translate:calc(-50% + var(--x)) calc(-50% + var(--y));
  width:158px;height:52px;border-radius:13px;display:grid;place-items:center;
  font-size:12px;color:var(--ink-3);letter-spacing:.06em;
  border:1px dashed oklch(.90 .02 92/.16);
  transition:border-color .22s var(--e-out),color .22s,background .22s}
.slot:hover{color:var(--ink-2);border-color:oklch(.845 .128 84/.42);background:oklch(1 0 0/.03)}
.slot .ai{position:absolute;inset:0;display:grid;place-items:center;opacity:0;
  font-size:12px;color:var(--ink-2);transition:opacity .2s}
.slot:hover .txt{opacity:0}
.slot:hover .ai{opacity:1}
.slot .txt{transition:opacity .2s}
.slot.wait{animation:breathe 3.4s ease-in-out infinite}
@keyframes breathe{0%,100%{border-color:oklch(.90 .02 92/.13)}50%{border-color:oklch(.90 .02 92/.30)}}
@media (prefers-reduced-motion:reduce){.slot.wait{animation:none}}

.floorfoot{position:absolute;left:0;right:0;bottom:18px;text-align:center;
  font-size:11.5px;color:var(--ink-3);letter-spacing:.04em}

/* ── 右欄 ───────────────────────────────────────────────── */
.rail{
  width:336px;flex:none;border-left:1px solid var(--hair);
  padding:26px 30px 24px;display:flex;flex-direction:column;
  transition:width .42s var(--e-out);overflow:hidden;overflow-y:auto}
.railhd{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:4px}
.railhd h2{font-size:14px;font-weight:600;letter-spacing:.02em}
.gear{display:flex;align-items:center;gap:7px;font-size:12px;color:var(--ink-3);
  padding:7px 12px;border-radius:99px;transition:color .18s,background .18s}
.gear:hover{color:var(--ink);background:oklch(1 0 0/.05)}
.gear svg{width:13px;height:13px;fill:none;stroke:currentColor;stroke-width:1.4}
.railsub{font-size:11.5px;color:var(--ink-3);margin:0 0 14px}

.grp{margin-top:16px}
.grp>.cap{display:block;margin-bottom:2px;opacity:.85}
.r{display:flex;align-items:baseline;justify-content:space-between;gap:14px;
  padding:10px 0;border-bottom:1px solid var(--hair-2)}
.r:last-child{border-bottom:0}
.r .k{font-size:12.5px;color:var(--ink-3)}
.r .v{font-size:13.5px;color:var(--ink);font-weight:500}
.r .v small{font-size:11px;color:var(--ink-3);font-weight:400}

.sum{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin:auto 0 20px;
  padding-top:20px;border-top:1px solid var(--hair)}
.edit .sum{position:sticky;bottom:0;margin:8px 0 0;padding:16px 0 4px;
  background:linear-gradient(to top,var(--felt-deep) 72%,transparent);backdrop-filter:blur(3px)}
.sum .k{font-size:9.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-3);margin-bottom:5px}
.sum .v{font-family:"IBM Plex Mono",monospace;font-size:25px;font-weight:500;line-height:1;
  font-variant-numeric:tabular-nums}
.railfoot{font-size:11px;color:var(--ink-3);text-align:center;margin-top:11px;letter-spacing:.03em}

/* ── 設定：右欄長大，桌子退後 ───────────────────────────── */
.edit{display:none}
body.set .edit{display:block}
body.set .view{display:none}
body.set .rail{width:472px}
.stage{transition:transform .42s var(--e-out),opacity .42s var(--e-out),filter .42s var(--e-out)}
body.set .stage{transform:scale(.94);opacity:.34;filter:saturate(.6)}
body.set .floorfoot{opacity:0}
.f{padding:14px 0;border-bottom:1px solid var(--hair-2)}
.f:last-child{border-bottom:0}
.f>label{display:block;font-size:12.5px;color:var(--ink-2);margin-bottom:9px;letter-spacing:.02em}
.opts{display:flex;gap:5px;flex-wrap:wrap}
.opt{padding:7px 14px;border-radius:99px;border:1px solid var(--hair);
  font-size:12.5px;color:var(--ink-3);transition:border-color .16s,color .16s,background-color .16s}
.opt:hover{color:var(--ink-2);border-color:var(--glass-edge)}
.opt[aria-pressed=true]{border-color:var(--brass);color:var(--brass);background:var(--brass-soft)}
.note{margin:9px 0 0;font-size:11.5px;line-height:1.62;color:var(--ink-3);max-width:44ch}
.done{padding:8px 18px;border-radius:99px;font-size:12.5px;color:var(--ink);
  background:var(--glass);box-shadow:inset 0 1px 0 var(--glass-lip),0 0 0 1px var(--hair)}
.done:hover{background:oklch(.98 .012 92/.13)}

@media (max-width:1180px){
  .tbl{--rx:290px;--ry:190px}
  .plate .code{font-size:62px}
  .rail{width:302px}
  body.set .rail{width:420px}
}
/*==HTML==*/
<div class="pg">
  <header class="top">
    <div class="mk"><b>11</b><u>UP &amp; DOWN</u></div>
    <div class="you">
      <span class="nm">Francis</span>
      <img class="av" src="__AV__" alt="">
      <button class="ghost">離開房間</button>
    </div>
  </header>

  <main class="room">
    <section class="floor">
      <div class="stage">
        <div class="tbl">
          <div class="felt">
            <div class="grain"></div>
            <div class="plate">
              <span class="cap">房號</span>
              <span class="code bodoni">7K2M</span>
              <button><span class="hint"><i></i>按一下複製，貼給朋友</span></button>
            </div>
            <svg class="deck" viewBox="0 0 100 140"><use href="#cardback"/></svg>
          </div>
        </div>

        <div class="seat me" style="--x:0px;--y:292px">
          <img class="av" src="__AV__" alt="">
          <div class="who"><b>Francis</b><span class="sub"><em>房主</em> · 你</span></div>
        </div>
        <div class="seat l" style="--x:-338px;--y:168px">
          <div class="mono-av">哲</div>
          <div class="who"><b>阿哲</b><span class="sub"><span class="dot"></span>在線上</span></div>
        </div>
        <div class="slot wait" style="--x:-330px;--y:-168px">
          <span class="txt">空位</span><span class="ai">放一個 AI 進來</span>
        </div>
        <div class="seat" style="--x:0px;--y:-292px">
          <div class="mono-av">圓</div>
          <div class="who"><b>小圓</b><span class="sub"><span class="dot"></span>在線上</span></div>
        </div>
        <div class="slot" style="--x:330px;--y:-168px">
          <span class="txt">空位</span><span class="ai">放一個 AI 進來</span>
        </div>
        <div class="slot" style="--x:330px;--y:168px">
          <span class="txt">空位</span><span class="ai">放一個 AI 進來</span>
        </div>
      </div>
      <p class="floorfoot">誰進來誰就是一位，最多十個人 · 開打之後這桌就鎖起來</p>
    </section>

    <aside class="rail">
      <!-- 唯讀 -->
      <div class="view">
        <div class="railhd">
          <h2>這一桌的規則</h2>
          <button class="gear" id="toSet">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3.2"/><path d="M12 2.6v3M12 18.4v3M21.4 12h-3M5.6 12h-3M18.6 5.4l-2.1 2.1M7.5 16.5l-2.1 2.1M18.6 18.6l-2.1-2.1M7.5 7.5L5.4 5.4"/></svg>
            設定
          </button>
        </div>
        <p class="railsub">你是房主，只有你改得動。</p>

        <div class="grp">
          <span class="cap">叫墩</span>
          <div class="r"><span class="k">方式</span><span class="v">依序公開叫</span></div>
          <div class="r"><span class="k">末位限制</span><span class="v">the hook</span></div>
        </div>
        <div class="grp">
          <span class="cap">牌</span>
          <div class="r"><span class="k">牌組</span><span class="v">雙副</span></div>
          <div class="r"><span class="k">最小點數</span><span class="v">7 <small>以上</small></span></div>
          <div class="r"><span class="k">鬼牌</span><span class="v">不放</span></div>
        </div>
        <div class="grp">
          <span class="cap">計分</span>
          <div class="r"><span class="k">叫中</span><span class="v">10＋叫</span></div>
          <div class="r"><span class="k">叫 0 中了</span><span class="v">5 分</span></div>
          <div class="r"><span class="k">沒叫中</span><span class="v">扣差額</span></div>
        </div>

        <div class="sum">
          <div><div class="k">牌數</div><div class="v">64</div></div>
          <div><div class="k">最多每人</div><div class="v">11</div></div>
          <div><div class="k">總局數</div><div class="v">21</div></div>
        </div>
        <button class="go">開始</button>
        <p class="railfoot">三個人就位 · 兩人以上隨時可以開</p>
      </div>

      <!-- 設定 -->
      <div class="edit">
        <div class="railhd">
          <h2>規則設定</h2>
          <button class="done" id="toView">完成</button>
        </div>
        <p class="railsub">改了桌上每個人都會即時看到。</p>

        <div class="f">
          <label>叫墩</label>
          <div class="opts"><button class="opt" aria-pressed="true">依序公開叫</button><button class="opt">同時叫墩</button></div>
          <p class="note">從起始玩家開始一位一位叫，後面的人看得到前面叫了多少。</p>
        </div>
        <div class="f">
          <label>末位限制</label>
          <div class="opts"><button class="opt" aria-pressed="true">the hook</button><button class="opt">不限制</button></div>
          <p class="note">最後一位叫的人不得讓總叫墩數剛好等於總墩數：每一局一定有人要叫不中。</p>
        </div>
        <div class="f">
          <label>牌組</label>
          <div class="opts"><button class="opt">單副</button><button class="opt" aria-pressed="true">雙副</button></div>
          <p class="note">兩副牌。同點同花撞在同一墩時，先出的那張贏。</p>
        </div>
        <div class="f">
          <label>最小點數</label>
          <div class="opts"><button class="opt">9</button><button class="opt" aria-pressed="true">7</button><button class="opt">6</button><button class="opt">5</button><button class="opt">4</button><button class="opt">3</button><button class="opt">2</button></div>
        </div>
        <div class="f">
          <label>鬼牌</label>
          <div class="opts"><button class="opt" aria-pressed="true">不放</button><button class="opt">放兩張</button></div>
        </div>
        <div class="f">
          <label>叫中得分</label>
          <div class="opts"><button class="opt" aria-pressed="true">10＋叫</button><button class="opt">10×叫</button><button class="opt">10＋叫²</button></div>
          <p class="note">叫 3 中了 13 分。叫大墩沒有溢價，所以永遠叫最可能中的那個數。</p>
        </div>
        <div class="f">
          <label>叫 0 中了</label>
          <div class="opts"><button class="opt" aria-pressed="true">5 分</button><button class="opt">5＋該局張數</button></div>
        </div>
        <div class="f">
          <label>沒叫中</label>
          <div class="opts"><button class="opt" aria-pressed="true">扣差額</button><button class="opt">扣 10×差</button><button class="opt">扣差額²</button></div>
          <p class="note">叫 3 拿 4 扣 1 分。罰得很輕，所以去破壞別人很便宜。</p>
        </div>

        <div class="sum">
          <div><div class="k">牌數</div><div class="v">64</div></div>
          <div><div class="k">最多每人</div><div class="v">11</div></div>
          <div><div class="k">總局數</div><div class="v">21</div></div>
        </div>
        <p class="railfoot">六十四張牌、四個人，階梯走得到 11 張。</p>
      </div>
    </aside>
  </main>
</div>

<div class="dev">
  <button data-v="room" aria-pressed="true">開房</button>
  <button data-v="set">設定</button>
</div>
<script>
const setv = v => {
  document.body.classList.toggle("set", v === "set");
  document.querySelectorAll(".dev button").forEach(b => b.setAttribute("aria-pressed", b.dataset.v === v));
};
document.querySelector(".dev").onclick = e => { const b = e.target.closest("button"); if(b) setv(b.dataset.v); };
document.getElementById("toSet").onclick = () => setv("set");
document.getElementById("toView").onclick = () => setv("room");
document.addEventListener("click", e => {
  const o = e.target.closest(".opt");
  if(!o) return;
  o.parentElement.querySelectorAll(".opt").forEach(b => b.setAttribute("aria-pressed", "false"));
  o.setAttribute("aria-pressed", "true");
});
if(location.search.includes("set")) setv("set");
</script>
