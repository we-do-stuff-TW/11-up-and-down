/* TITLE: B 翻牌 · 一張一張揭曉 */
/* ── B 案：翻牌。三張牌背朝上放在桌上，第三名先翻、再第二、最後第一 ──────────
   翻牌是這個遊戲自己的手勢：叫墩翻王牌、收桌翻名次。牌面是米色的紙（跟房號那四張牌位同一種），
   角落的索引寫的不是點數是名次，中間站著那個人。第一名那張大一號、放中間、最後翻。 */
.hand{display:flex;align-items:flex-end;justify-content:center;gap:16px;perspective:1100px}
.pc{position:relative;width:118px;aspect-ratio:5/7;flex:none;
  transform-style:preserve-3d;transform:rotateY(180deg);
  animation:flip .64s var(--e-out) forwards;animation-delay:var(--d)}
.pc.p1{width:150px;margin-bottom:22px}
@keyframes flip{to{transform:none}}
.pc>div{position:absolute;inset:0;border-radius:11px;backface-visibility:hidden;-webkit-backface-visibility:hidden}
/* 牌背：跟線上那副一樣是深紅的格紋，中間一個 11 的菱形 */
.pc .back{transform:rotateY(180deg);
  background:
    repeating-linear-gradient(45deg,oklch(1 0 0/.06) 0 1px,transparent 1px 9px),
    repeating-linear-gradient(-45deg,oklch(1 0 0/.06) 0 1px,transparent 1px 9px),
    linear-gradient(160deg in oklab,#8E2228,#5E1418);
  box-shadow:inset 0 0 0 1px rgba(0,0,0,.35),inset 0 0 0 5px #F1E9D6,inset 0 0 0 6px rgba(0,0,0,.18),var(--sh-1)}
.pc .back::after{content:"11";position:absolute;left:50%;top:50%;translate:-50% -50%;
  width:40px;height:40px;rotate:45deg;display:grid;place-items:center;
  border:1px solid oklch(1 0 0/.5);color:#F1E9D6;font-family:"Bodoni Moda",Georgia,serif;font-weight:700;font-size:15px}
/* 牌面：米色的紙，索引是名次 */
.pc .face{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;
  background:linear-gradient(158deg in oklab,#FDFAF3,var(--stock) 46%,var(--stock-2));
  color:var(--stock-ink);
  box-shadow:inset 0 0 0 1px rgba(26,23,20,.16),inset 0 1px 0 rgba(255,255,255,.9),var(--sh-2)}
.pc .face::before{content:"";position:absolute;inset:5px;border-radius:7px;border:.5px solid var(--foil);opacity:.45}
.pc .ix{position:absolute;left:9px;top:7px;font-family:"Bodoni Moda",Georgia,serif;font-weight:600;
  font-size:22px;line-height:1;font-variation-settings:"opsz" 6;color:var(--stock-ink-2)}
.pc .ix.b{left:auto;right:9px;top:auto;bottom:7px;rotate:180deg}
.pc .faces{display:flex}
.pc .faces>*{width:40px;height:40px;font-size:14px;color:var(--stock-ink);
  background:var(--stock-3);box-shadow:0 0 0 1px var(--stock-hair)}
.pc .faces>*+*{margin-left:-10px}
.pc .nm{font-size:13px;font-weight:600;line-height:1.25;max-width:88%;text-wrap:balance;letter-spacing:.01em}
.pc .sc{font-family:"IBM Plex Mono",ui-monospace,monospace;font-variant-numeric:tabular-nums;
  font-size:14px;color:var(--stock-ink-2)}
.pc.p1 .ix{color:var(--foil);font-size:28px}
.pc.p1 .faces>*{width:54px;height:54px;font-size:18px}
.pc.p1 .nm{font-size:16px}
.pc.p1 .sc{color:var(--foil);font-size:16px}
.pc.p1 .face{box-shadow:inset 0 0 0 1px rgba(26,23,20,.16),inset 0 1px 0 rgba(255,255,255,.9),var(--sh-2),
  0 0 60px oklch(.845 .128 84/.16)}
/* 桌上那三張牌的影子：一條線，牌放在它上面 */
.line{width:min(560px,100%);height:1px;background:var(--hair);margin:26px auto 0}

@media (prefers-reduced-motion:reduce){
  .pc{transform:none;animation:fadeIn .2s ease both}
  .pc .back{display:none}
}
@media (max-width:760px){
  .hand{gap:10px}
  .pc{width:96px}.pc.p1{width:120px;margin-bottom:16px}
  .pc .faces>*{width:34px;height:34px;font-size:12px}.pc.p1 .faces>*{width:44px;height:44px;font-size:15px}
  .pc .nm{font-size:12px}.pc.p1 .nm{font-size:14px}
  .pc .ix{font-size:18px}.pc.p1 .ix{font-size:23px}
}
/*==HTML==*/
    <div class="stage">
      <div class="hand" id="hand"></div>
      <div class="line"></div>
    </div>
<script>
(function(){
  const T = END.tiers;
  const order = T.length >= 3 ? [T[1], T[0], T[2]] : T.length === 2 ? [T[0], T[1]] : [T[0]];
  /* 第三張先翻，冠軍最後：每張差 .28 秒，翻完前一張的一半再翻下一張 */
  const delay = function(t){ return {1:".62s", 2:".32s"}[T.indexOf(t) + 1] || ".05s"; };
  document.getElementById("hand").innerHTML = order.map(function(t){
    const k = T.indexOf(t) + 1;
    return '<div class="pc p' + k + '" style="--d:' + delay(t) + '">' +
      '<div class="back"></div>' +
      '<div class="face"><span class="ix">' + t.pos + '</span><span class="ix b">' + t.pos + '</span>' +
      '<div class="faces">' + t.who.map(function(p){ return face(p); }).join("") + '</div>' +
      '<span class="nm">' + t.who.map(function(p){ return p.me ? "你" : p.n; }).join("、") + '</span>' +
      '<span class="sc">' + sc(t.sc) + '</span></div></div>';
  }).join("");
})();
</script>
