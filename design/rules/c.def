/* TITLE: C 規則單拿近 · 就地選 */
/* ── C 案：不另開一份，把原來那張規則單拿近 ──────────────────────
   按下設定，右欄那張紙就從邊上浮起來變成一個視窗——同一份清單、同樣的順序、
   同樣的 leader dots，只是現在每一行都按得下去。點哪一行，選項就在那一行旁邊
   跳出一個小選單，一次只面對一件事。看的跟改的是同一張紙，不是兩份長得像的東西。 */
body.set .plan{opacity:.7;transition:opacity .3s var(--e-out)}
.plan{transition:opacity .3s var(--e-out)}

.sheet{transition:margin .3s var(--e-out),box-shadow .3s var(--e-out),background .3s}
body.set .sheet{
  margin:14px 14px 14px 0;border-left:0;border-radius:18px;width:398px;overflow:visible;
  background:linear-gradient(178deg in oklab,
    color-mix(in oklab,var(--felt) 91%,oklch(1 0 0)),
    color-mix(in oklab,var(--felt) 97%,oklch(1 0 0)));
  box-shadow:inset 0 1px 0 var(--glass-lip), 0 0 0 1px var(--hair),
    0 2px 6px rgba(0,0,0,.30), 0 34px 76px rgba(0,0,0,.5)}

/* 能改的那幾行：平常跟唯讀時長得一樣，滑上去才顯出按得下去 */
body.set .r[data-k]{cursor:pointer;border-radius:8px;margin:0 -8px;padding:7px 8px;
  transition:background .16s}
body.set .r[data-k]:hover{background:oklch(1 0 0/.05)}
body.set .r[data-k]:hover .k{color:var(--ink-2)}
body.set .r[data-k].on{background:oklch(1 0 0/.06)}
body.set .r[data-k].on .v{color:var(--brass)}
.r[data-k]{position:relative}

/* 小選單：貼著那一行往左跳出來 */
.menu{position:absolute;right:calc(100% + 15px);top:50%;translate:0 -50%;z-index:6;
  width:232px;padding:8px;border-radius:14px;
  background:linear-gradient(178deg in oklab,
    color-mix(in oklab,var(--felt) 97%,oklch(1 0 0)),
    color-mix(in oklab,var(--felt) 92%,oklch(1 0 0)));
  box-shadow:inset 0 1px 0 var(--glass-lip), 0 0 0 1px var(--hair),
    0 2px 6px rgba(0,0,0,.3), 0 22px 48px rgba(0,0,0,.5);
  transform-origin:100% 50%;animation:menuIn .18s var(--e-out) both}
@keyframes menuIn{from{opacity:0;transform:scale(.94) translateX(6px)}to{opacity:1;transform:none}}
@media (prefers-reduced-motion:reduce){.menu{animation:none}}
.menu::after{content:"";position:absolute;right:-5px;top:50%;translate:0 -50%;
  width:10px;height:10px;rotate:45deg;
  background:color-mix(in oklab,var(--felt) 94%,oklch(1 0 0));
  box-shadow:1px -1px 0 var(--hair)}
.menu>.cap{display:block;padding:5px 10px 6px}
.menu button{display:flex;width:100%;align-items:center;gap:9px;padding:7px 10px;border-radius:9px;
  font-size:13.5px;color:var(--ink-3);transition:background .14s,color .14s}
.menu button i{width:5px;height:5px;border-radius:99px;background:transparent;flex:none}
.menu button:hover{background:oklch(1 0 0/.06);color:var(--ink-2)}
.menu button[aria-pressed=true]{color:var(--ink)}
.menu button[aria-pressed=true] i{background:var(--brass)}

/* 底下那顆銅色「開始」不動：改完規則直接開局，不必先按完成再按開始 */
body.set .sheethd .lnk{color:var(--ink)}
body.set .sheethd .lnk::after{background:var(--brass)}

@media (max-width:760px){
  body.set .plan{opacity:1}
  body.set .sheet{margin:0 10px 10px;border-radius:18px;width:auto;border-top:0}
  /* 螢幕左邊沒有空間放小選單，就地展開在那一行底下 */
  .menu{position:static;translate:none;width:100%;margin:6px 0 2px;
    animation:menuDown .18s var(--e-out) both}
  @keyframes menuDown{from{opacity:0;transform:translateY(-4px)}to{opacity:1;transform:none}}
  .menu::after{display:none}
  .menu button{padding:9px 10px;font-size:14px}
  /* 那一行改成可換行，選單就掉到自己那一行——不能改 display:block，
     不然 leader dots 那根 flex:1 的線會塌成 0 寬 */
  body.set .r[data-k].on{flex-wrap:wrap}
}
/*==HTML==*/
<div class="dev">
  <button data-v="room">開房</button>
  <button data-v="set" aria-pressed="true">設定</button>
</div>
<script>
/* 這一案的選項資料自己帶一份：正式版是 RULE_UI，形狀一樣 */
const RULES = {
  bidMode:{cap:"叫墩方式", o:["依序公開叫","同時叫墩"], i:0},
  hook:   {cap:"末位限制", o:["the hook","不限制"], i:0},
  decks:  {cap:"牌組",     o:["單副","雙副"], i:1},
  minRank:{cap:"最小點數", o:["9 以上","7 以上","6 以上","5 以上","4 以上","3 以上","2 以上"], i:1},
  jokers: {cap:"鬼牌",     o:["不放","放兩張"], i:0},
  hit:    {cap:"叫中得分", o:["10＋叫","10×叫","10＋叫²"], i:0},
  zero:   {cap:"叫 0 中了", o:["5 分","5＋該局張數"], i:0},
  miss:   {cap:"沒叫中",   o:["扣差額","扣 10×差","扣差額²"], i:0}
};
const sheet = document.querySelector(".sheet");
/* 設定中，底下換成「完成」；右欄標題那顆也跟著變 */
const closeMenu = () => {
  const m = sheet.querySelector(".menu");
  if(m) m.remove();
  sheet.querySelectorAll(".r.on").forEach(r => r.classList.remove("on"));
};
const openMenu = row => {
  const k = row.dataset.k, R = RULES[k];
  if(!R) return;
  const was = row.classList.contains("on");
  closeMenu();
  if(was) return;                                  /* 再點一次就收起來 */
  row.classList.add("on");
  if(innerWidth <= 760) setTimeout(() => row.scrollIntoView({block:"center", behavior:"smooth"}), 20);
  row.insertAdjacentHTML("beforeend", '<div class="menu" role="listbox"><span class="cap">' + R.cap + '</span>' +
    R.o.map((t, n) => '<button role="option" data-n="' + n + '" aria-pressed="' + (n === R.i) + '"><i></i>' + t + '</button>').join("") +
    '</div>');
};
const setv = v => {
  const on = v === "set";
  document.body.classList.toggle("set", on);
  if(!on) closeMenu();
  document.getElementById("toSet").textContent = on ? "完成" : "設定";
  document.querySelectorAll(".dev button").forEach(b => b.setAttribute("aria-pressed", b.dataset.v === v));
};
document.querySelector(".dev").onclick = e => { const b = e.target.closest("button"); if(b) setv(b.dataset.v); };
document.getElementById("toSet").onclick = () => setv(document.body.classList.contains("set") ? "room" : "set");
document.addEventListener("click", e => {
  if(e.target.closest("[data-close]")) return setv("room");
  const pick = e.target.closest(".menu button");
  if(pick){
    const row = pick.closest(".r"), R = RULES[row.dataset.k];
    R.i = +pick.dataset.n;
    const t = R.o[R.i].replace(/^(\d+) 以上$/, '$1 <small>以上</small>');
    row.querySelector(".v").innerHTML = t;
    closeMenu();
    return;
  }
  const row = e.target.closest(".r[data-k]");
  if(row && document.body.classList.contains("set")) return openMenu(row);
  if(!e.target.closest(".sheet") && !e.target.closest(".dev")) closeMenu();
});
addEventListener("keydown", e => { if(e.key === "Escape"){ if(sheet.querySelector(".menu")) closeMenu(); else setv("room"); } });
if(location.search.includes("nodev")) document.querySelector(".dev").hidden = true;
setv(location.search.includes("room") ? "room" : "set");
if(!location.search.includes("room")) openMenu(sheet.querySelector('[data-k="minRank"]'));
</script>
